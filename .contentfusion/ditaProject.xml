<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<project xmlns="https://www.dita-ot.org/project">
    <context id="user_manual_multilingual" name="User Manual Multilingual">
        <input href="../software-docs-starter-multilingual.ditamap"/>
    </context>
    <context id="user_manual_en" name="User Manual EN">
        <input href="../en/userguide.ditamap"/>
    </context>
    <context id="user_manual_de" name="User Manual - DE">
        <input href="../de-DE/userguide.ditamap"/>
        <?language de-DE?>
        <?translation-source {"contextId":"user_manual_en"}?>
    </context>
    <context id="user_manual_fr" name="User Manual - FR">
        <input href="../fr-FR/userguide.ditamap"/>
        <?language fr-FR?>
        <?translation-source {"contextId":"user_manual_en"}?>
    </context>
    <publication id="webhelp" transtype="webhelp-responsive"/>
    <publication id="pdf" transtype="pdf-css-html5"/>
    <deliverable id="d-User_Manual_to_EN_WebHelp" name="User Manual to EN WebHelp Responsive">
        <context idref="user_manual_en"/>
        <output href="webhelp-output"/>
        <publication idref="webhelp">
            <param href="../publishing/template.opt" name="webhelp.publishing.template"/>
            <param name="editlink.enable.edit.in.content.fusion.workspace" value="false"/>
            <param name="current.language" value="English"/>
        </publication>
    </deliverable>
    <deliverable id="d-User_Manual_to_DE_WebHelp" name="User Manual to WebHelp Responsive - DE">
        <context idref="user_manual_de"/>
        <output href="webhelp-output"/>
        <publication idref="webhelp">
            <param href="../publishing/template.opt" name="webhelp.publishing.template"/>
            <param name="editlink.enable.edit.in.content.fusion.workspace" value="false"/>
        </publication>
    </deliverable>
    <deliverable id="d-User_Manual_to_Multilingual_WebHelp" name="User Manual to Multilingual WebHelp Responsive">
        <context idref="user_manual_multilingual"/>
        <output href="webhelp-output"/>
        <publication idref="webhelp">
            <param href="cf://templates/Oxygen" name="webhelp.publishing.template"/>
        </publication>
    </deliverable>
    <deliverable id="d-User_Manual_to_Multilingual_PDF" name="User Manual to Multilingual PDF">
        <context idref="user_manual_multilingual"/>
        <output href="pdf-output"/>
        <publication idref="pdf">
            <param href="cf://templates/Oxygen" name="pdf.publishing.template"/>
        </publication>
    </deliverable>
    <deliverable id="d-User_Manual_to_FR_WebHelp" name="User Manual to WebHelp Responsive - FR">
        <context idref="user_manual_fr"/>
        <output href="webhelp-output"/>
        <publication idref="webhelp">
            <param href="cf://templates/Oxygen" name="webhelp.publishing.template"/>
        </publication>
    </deliverable>
    
</project>
